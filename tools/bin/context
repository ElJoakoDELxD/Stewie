#!/usr/bin/env python3
import json
import os
import sys

SMALL_WINDOW = ("claude-haiku-4", "claude-3")


def latest_usage(path):
    found = None
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if not isinstance(d, dict) or d.get("type") != "assistant" or d.get("isSidechain"):
                continue
            m = d.get("message")
            u = m.get("usage") if isinstance(m, dict) else None
            if not isinstance(u, dict):
                continue
            parts = [u.get(k) for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens")]
            n = sum(p for p in parts if isinstance(p, int) and not isinstance(p, bool))
            if n > 0:
                found = (n, str(m.get("model") or ""))
    return found


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else os.environ.get("STEWIE_TRANSCRIPT", "")
    if not path:
        return
    try:
        found = latest_usage(path)
    except OSError:
        return
    if not found:
        return
    tokens, model = found
    window = 200000 if model.startswith(SMALL_WINDOW) else 1000000
    try:
        window = int(os.environ.get("STEWIE_CONTEXT_WINDOW") or window)
    except ValueError:
        pass
    if window > 0:
        print("%d %d %d" % (min(100, tokens * 100 // window), tokens, window))


main()
